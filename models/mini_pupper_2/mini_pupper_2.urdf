  <gazebo reference="lidar_link">
    <material>Gazebo/FlatBlack</material>
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>1040</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>6.28</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.2</min>
          <max>50.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.004</stddev>
        </noise>
      </lidar>
      <topic>/scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
    </sensor>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_publish_frequency>10.0</odom_publish_frequency>
      <odom_topic>odom</odom_topic>
    </plugin>
  </gazebo>
  <link name="imu_link">
    <inertial>
      <mass value="0.0001"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="1e-09" ixy="0.0" ixz="0.0" iyy="1e-09" iyz="0.0" izz="1e-09"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>
  <gazebo reference="imu_link">
    <sensor name="imu_controller" type="imu">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <topic>/imu/data</topic>
      <gz_frame_id>imu_link</gz_frame_id>
    </sensor>
  </gazebo>
  <!-- Simulated camera mounted to the front body -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <material name="blue">
        <ambient>0 0 1 1</ambient>
        <diffuse>0 0 1 1</diffuse>
      </material>
    </visual>
  </link>
  <joint name="bodyfront_camera_joint" type="fixed">
    <parent link="Body_front"/>
    <child link="camera_link"/>
    <origin rpy="0 0 0" xyz="0.02 0 0.02"/>
  </joint>
  <gazebo reference="camera_link">
    <sensor name="sim_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>30.0</update_rate>
      <visualize>true</visualize>
      <camera name="camera">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>50</far>
        </clip>
      </camera>
      <topic>/image_raw</topic>
      <gz_frame_id>camera_link</gz_frame_id>
    </sensor>
  </gazebo>
  <ros2_control name="MiniPupper" type="system">
    <hardware>
      <plugin>mini_pupper_hardware/MiniPupperHardware</plugin>
      <param name="hardware_interface_type">esp32_proxy</param>
    </hardware>
    <joint name="base_lf1">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="lf1_lf2">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.994</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="lf2_lf3">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">-1.767</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="base_rf1">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rf1_rf2">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.994</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rf2_rf3">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">-1.767</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="base_lb1">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="lb1_lb2">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.994</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="lb2_lb3">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">-1.767</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="base_rb1">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rb1_rb2">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.994</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rb2_rb3">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">-1.767</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
</robot>
